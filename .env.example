# Bu dosyayı ".env" adıyla kopyalayın ve gerçek değerleri girin.
# .env dosyası .gitignore'da yer alır; asla koda, ön yüze veya loglara yazılmaz.

# ScraperAPI anahtarı (zorunlu) - tüm site istekleri bu anahtarla, country_code=tr ile gider
SCRAPERAPI_KEY=

# YZ sınıflandırma API'si (OpenAI uyumlu EVREN LLM)
EVREN_LLM_API_KEY=
AI_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
AI_MODEL=glm-5.3

# Sunucu
PORT=3000
# Hangi adreslere bağlanır (0.0.0.0 = ağdaki tüm cihazlar, 127.0.0.1 = yalnızca bu bilgisayar)
HOST=0.0.0.0
# Yayın modu erişim anahtarı: tanımlıysa API'ye yalnızca anahtarı bilen cihazlar erişir.
# İlk girişte tarayıcıda bir kez sorulur ve cihaza kaydedilir. Boş bırakılırsa kısıt kalkar.
ERISIM_ANAHTARI=

# Sayfa önbellek süresi (dakika). Fiyatlar hızlı değiştiği için çok uzun tutmayın.
CACHE_TTL_MINUTES=360

# SWR snapshot ömrü (dakika). Bu süre içinde taranmış ürün 0 sn'de gösterilir,
# arka planda tazelenir. Varsayılan 5 saat (300). 0 = özellik kapalı.
SNAPSHOT_TTL_MINUTES=300

# 🖨️ 3D baskı maliyet simülatörü varsayımları (isteğe bağlı)
# Ortalama yazıcı gücü (W), mesken elektrik tarifesi (TL/kWh), baskı hızı (g/saat)
BASKI_YAZICI_GUC_W=150
BASKI_ELEKTRIK_KWH_TL=2.9
BASKI_GRAM_SAAT=12.5

# 🔔 Web Push (VAPID). Boş bırakılırsa ilk açılışta otomatik üretilip
# settings tablosunda saklanır. Yedekten geri yüklemek için buraya yazın.
# Not: anahtarları değiştirmek mevcut cihaz aboneliklerini geçersiz kılar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi (mailto:... veya https://...). Boşsa alarm e-postası kullanılır.
VAPID_SUBJECT=

# 🧹 Önbellek bakımı (data/cache/*.json) — her gece 04:00'te çalışır.
# Bu günden eski dosyalar silinir (varsayılan 30).
CACHE_SAKLAMA_GUN=30
# Toplam önbellek boyutu bu MB'ı aşarsa en eski dosyalar silinir.
# 0 = kapalı. Disk baskısı varsa ör. 2048 (2 GB) yapın.
CACHE_MAKS_MB=0

# Bir sitede incelenecek en fazla aday ürün sayısı
MAX_CANDIDATES=3

# Fiyat alarmı kontrol aralığı (dakika)
ALARM_CHECK_MINUTES=360

# Genel erişim adresi (Telegram botunun "Sitede Detaylı İncele" linki için).
# Boş bırakılırsa http://localhost:PORT kullanılır.
PUBLIC_URL=

# Bağlantı havuzu/ısıtma (varsayılan KAPALI — bazı sitelerde bozuk sayfa döndürüyordu)
# HTTP_POOL=1
# HTTP_POOL_WARMUP=1
