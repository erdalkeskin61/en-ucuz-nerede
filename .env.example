# Bu dosyayı ".env" adıyla kopyalayın ve gerçek değerleri girin.
# .env dosyası .gitignore'da yer alır; asla koda, ön yüze veya loglara yazılmaz.

# ScraperAPI anahtarı (isteğe bağlı - boş bırakılırsa doğrudan impit + tarayıcı kullanılır)
SCRAPERAPI_KEY=

# YZ sınıflandırma API'si (OpenAI uyumlu EVREN LLM)
EVREN_LLM_API_KEY=
AI_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
AI_MODEL=glm-5.3

# Sunucu
PORT=3000
# Hangi adreslere bağlanır (0.0.0.0 = ağdaki tüm cihazlar, 127.0.0.1 = yalnızca bu bilgisayar)
HOST=0.0.0.0
# Yayın modu erişim anahtarı: tanımlıysa API'ye yalnızca anahtarı bilen cihazlar erişir.
# İlk girişte tarayıcıda bir kez sorulur ve cihaza kaydedilir. Boş bırakılırsa kısıt kalkar.
ERISIM_ANAHTARI=
# Yönetici paneli (/admin.html) ve yönetici API uçları için anahtar.
# Canlı yayında mutlaka doldurun; boş bırakılırsa yalnızca localhost üzerinden erişilebilir.
ADMIN_ANAHTARI=

# Sayfa önbellek süresi (dakika). Fiyatlar hızlı değiştiği için çok uzun tutmayın.
CACHE_TTL_MINUTES=360

# SWR snapshot ömrü (dakika). Bu süre içinde taranmış ürün 0 sn'de gösterilir,
# arka planda tazelenir. Varsayılan 5 saat (300). 0 = özellik kapalı.
SNAPSHOT_TTL_MINUTES=300

# 🖨️ 3D baskı maliyet simülatörü varsayımları (isteğe bağlı)
# Ortalama yazıcı gücü (W), mesken elektrik tarifesi (TL/kWh), baskı hızı (g/saat)
BASKI_YAZICI_GUC_W=150
BASKI_ELEKTRIK_KWH_TL=2.9
BASKI_GRAM_SAAT=12.5

# 🔔 Web Push (VAPID). Boş bırakılırsa ilk açılışta otomatik üretilip
# settings tablosunda saklanır. Yedekten geri yüklemek için buraya yazın.
# Not: anahtarları değiştirmek mevcut cihaz aboneliklerini geçersiz kılar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi (mailto:... veya https://...). Boşsa alarm e-postası kullanılır.
VAPID_SUBJECT=

# 🧹 Önbellek bakımı (data/cache/*.json) — her gece 04:00'te çalışır.
# Bu günden eski dosyalar silinir (varsayılan 30).
CACHE_SAKLAMA_GUN=30
# Toplam önbellek boyutu bu MB'ı aşarsa en eski dosyalar silinir.
# 0 = kapalı. Disk baskısı varsa ör. 2048 (2 GB) yapın.
CACHE_MAKS_MB=0

# Bir sitede incelenecek en fazla aday ürün sayısı
MAX_CANDIDATES=3

# Fiyat alarmı kontrol aralığı (dakika)
ALARM_CHECK_MINUTES=360

# Genel erişim adresi — aşağıdaki "CANLI YAYIN" bölümünde tanımlanır.
# (Burada boş bırakın; yerelde otomatik olarak http://localhost:PORT kullanılır.)

# Bağlantı havuzu/ısıtma (varsayılan KAPALI — bazı sitelerde bozuk sayfa döndürüyordu)
# HTTP_POOL=1
# HTTP_POOL_WARMUP=1


# =============================================================================
# 🌍 CANLI YAYIN — Azure VM + Cloudflare + Docker/Caddy (2026-11-18)
# =============================================================================
# Aşağıdaki değerler yalnızca üretim (.com) ortamı içindir. Yerelde boş
# bırakılabilir; uygulama yerel varsayılanlarla çalışmaya devam eder.

# Yayın adresi (SONUNDA EĞİK ÇİZGİ YOK). Sitemap, og:url, canonical ve
# Telegram bot linkleri bu adresi kullanır.
#   ör. https://baskihesap.tech
PUBLIC_URL=

# Google Analytics 4 (GA4) ölçüm kimliği (isteğe bağlı).
# Tanımlanırsa tüm HTML ve ürün/kategori sayfalarına gtag.js otomatik eklenir
# ve arama / sepet / sponsor / mağaza çıkış tıklamaları ölçülür.
#   ör. G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# IndexNow API anahtarı (isteğe bağlı — boş bırakılırsa otomatik üretilip
# veritabanında saklanır ve Bing/Yandex'e anlık dizin bildirimi yapılır).
INDEXNOW_KEY=

# Kalıcı veri dizini (SQLite + WAL + önbellek). Docker'da volume'a bağlanır.
# Tanımsızsa proje kökündeki `data/` kullanılır.
# DATA_DIR=/app/data

# 🚨 YÖNETİCİ ANAHTARI — canlıda MUTLAKA doldurun!
# En az 24 karakter, tahmin edilemez (ör. openssl rand -hex 24).
# Boş kalırsa /admin.html yalnızca loopback'e açılır; ters vekil arkasında
# bu, panelin İnternet'e açılması demek olabilir. Sunucu açılışta uyarır.
ADMIN_ANAHTARI=
# Genel API erişim anahtarı (isteğe bağlı). Tanımlarsanız istemciler
# x-erisim-anahtari başlığı veya ?anahtar= ile erişir. Boşsa kısıt yok.
ERISIM_ANAHTARI=

# Ters vekil güveni (Cloudflare → Caddy → Node zinciri).
#   1        = ilk atlama (Caddy) güvenilir — Docker/Caddy için VARSAYILAN
#   loopback = yalnızca yerel vekil (vekil aynı makinede)
#   false/0  = vekil yok (doğrudan internete açık)
# Sayı veya CIDR listesi de verilebilir: "loopback,172.16.0.0/12"
TRUST_PROXY=1

# Caddy/Let's Encrypt alan adı ve bildirim e-postası (docker-compose okur).
SITE_DOMAIN=baskihesap.tech
ACME_EMAIL=

# 🧬 Chrome TLS parmak izi katmanı (impit). "1" = KAPALI (acil durum).
# Normalde BOŞ bırakın: impit kotasız ve hızlıdır.
IMPIT_KAPALI=

# 🖥️ Chromium davranışı
# TARAYICI_KAPALI=1 → acil bellek koruma modu: tarayıcı hiç başlatılmaz,
#   dürüst hata döner (4 GB VM'de RAM darsa kullanın).
TARAYICI_KAPALI=
# Uzak tarayıcı (ayrı konteyner/servis). Tanımlıysa yerel Chromium açılmaz.
#   ws://chromium:3000  (Playwright server)
#   http://chromium:9222 (CDP)
REMOTE_BROWSER_URL=
# Korumalı TR siteleri için TR VDS / konut HTTP/SOCKS5 çıkış vekili (isteğe bağlı)
#   ör. http://kullanici:sifre@TR_VDS_IP:3128  veya  socks5://host.docker.internal:1080
TR_PROXY_URL=
# Yerel başlatma kanalı: auto | chrome | chromium | none
TARAYICI_CHANNEL=auto
# Boşta kalma süresi (ms) — RAM tasarrufu için tarayıcı kapanır.
TARAYICI_BOS_KALMA_MS=180000

# 🚦 IP bazlı hız sınırı (dakikadaki istek). Loopback varsayılan olarak muaf.
RL_COMPARE=20
RL_ONERI=20
RL_SEPET=20
RL_BARKOD=30
RL_GORSEL=10
RL_BASKI=60
# Canlı doğrulama/test için loopback muafiyetini kapatın.
RL_LOOPBACK_MUAF=1

# 🗂️ Katalog senkronizasyonu (Shopify/Woo/sitemap beslemeleri)
# Kaç saatte bir yenilensin; 0/boş → varsayılan 6 saat. KATALOG_SYNC=0 kapatır.
KATALOG_SYNC_SAAT=6
KATALOG_SYNC=
# Host başına nazik bekleme (ms)
KATALOG_HOST_ARASI_MS=900

# Chromium imajı kurulsun mu? (docker build arg)
PLAYWRIGHT_KUR=1

# 🛒 Resmî eBay Browse API (opsiyonel — tanımlıysa ebay_us ve ebay_fr API üzerinden çalışır)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Partner Network (EPN) Campaign ID (opsiyonel — tanımlıysa afiliye linki döner)
EBAY_CAMPAIGN_ID=
# eBay Marketplace Account Deletion doğrulama jetonu (32-80 karakter; developer.ebay.com/my/keys bildirim ekranından)
EBAY_VERIFICATION_TOKEN=
